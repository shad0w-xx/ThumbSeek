// Version info for ThumbSeek.dll and (with /dSETUP) ThumbSeek-setup.exe.
#include <winver.h>
#define VER 1,1,1,0
#define VERSTR "1.1.1"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER
PRODUCTVERSION VER
FILEOS VOS_NT_WINDOWS32
#ifdef SETUP
FILETYPE VFT_APP
#else
FILETYPE VFT_DLL
#endif
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "ProductName", "ThumbSeek"
            VALUE "ProductVersion", VERSTR
            VALUE "FileVersion", VERSTR
#ifdef SETUP
            VALUE "FileDescription", "ThumbSeek setup"
            VALUE "OriginalFilename", "ThumbSeek-setup.exe"
#else
            VALUE "FileDescription", "ThumbSeek video thumbnail handler"
            VALUE "OriginalFilename", "ThumbSeek.dll"
#endif
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
